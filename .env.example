# =============================================================================
# AGRISMART AI — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and replace placeholders with your actual keys.
# DO NOT COMMIT REAL CREDENTIALS OR .env TO VERSION CONTROL.
# =============================================================================

# Application Environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000/api/v1

# Supabase Cloud Project Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder

# Supabase Cloud PostgreSQL Direct Database Connection (For Migration Runner)
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Format (Direct): postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Format (Pooler): postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Google Gemini AI Integration (Official @google/genai SDK)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# Weather Provider (Open-Meteo API / Configurable Provider)
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
WEATHER_API_KEY=

# AI Runtime Guardrails
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=4096
AI_MAX_REQUESTS_PER_MINUTE=15

# File Upload Configuration (Crop leaf/specimen uploads)
MAX_IMAGE_SIZE_MB=8
MAX_IMAGE_COUNT=5

# Security Configuration
JWT_AUDIENCE=authenticated
CORS_ORIGIN=http://localhost:5173

# Logging & Observability
LOG_LEVEL=info

# Optional Vector Search & Semantic Grounding
ENABLE_VECTOR_SEARCH=false
EMBEDDING_MODEL=text-embedding-004
